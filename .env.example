# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-secure-jwt-secret-string
NEXT_PUBLIC_APP_URL=http://crm.airlinesconsolidator.com

# Email Delivery Provider (options: 'gmail', 'ses', 'mock')
# Switch to 'gmail' to send via Gmail SMTP, or 'ses' to send via AWS SES
EMAIL_PROVIDER=gmail

# Where portal-visit notifications are sent (reuses the sender above).
# No CS inbox yet — set this to your own address to receive the alerts.
CS_TEAM_EMAIL=your-email@example.com

# 1. Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_EMAIL=your-email@gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# 2. AWS Credentials (for S3 and SES)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1

# 3. AWS S3 Storage (Developer Tools: S3 Image Manager)
AWS_S3_BUCKET=your-s3-bucket-name
S3_BUCKET_NAME=your-s3-bucket-name
# AWS_S3_CUSTOM_DOMAIN=https://cdn.yourdomain.com

# 4. AWS SES Configuration (Developer Tools: SMTP Tester)
SES_FROM_EMAIL=your-verified-email@domain.com
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=your-ses-smtp-username
SES_SMTP_PASSWORD=your-ses-smtp-password
