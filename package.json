{
  "name": "flight-lead-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next build",
    "build:low-mem": "node --max-old-space-size=1024 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "seed:force": "tsx --tsconfig tsconfig.json scripts/seed.ts --force",
    "seed:template": "tsx --tsconfig tsconfig.json scripts/seed-booking-template.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.10.0",
    "next": "^15.1.7",
    "nodemailer": "^6.10.0",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
