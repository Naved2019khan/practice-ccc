# Database
MONGODB_URI=mongodb://127.0.0.1:27017/flight-crm

# Authentication
JWT_SECRET=your-secure-jwt-secret-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery Configuration (options: 'gmail', 'ses', 'mock')
EMAIL_PROVIDER=mock

# Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_FROM_EMAIL=Flight CRM <notifications@flightcrm.com>

# AWS SES
SES_KEY=your-ses-access-key
SES_SECRET=your-ses-secret-key
SES_REGION=us-east-1
SES_FROM_EMAIL=Flight CRM <notifications@flightcrm.com>
